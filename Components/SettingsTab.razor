@inherits StateComponent
@inject Dialogs D

@{
    var st = S.Data.Settings;
}

<section class="settings-section">
    <div class="settings-title">Theme</div>
    <div class="card settings-card theme-card">
        <button class="theme-menu @(_open == "bg" ? "open" : "")" @onclick='() => ToggleMenu("bg")' aria-expanded="@(_open == "bg" ? "true" : "false")">
            <span class="theme-menu-swatch" style="background:@BgCss(st.Background)"></span>
            <span class="row-main">
                <span class="row-title">Main color</span>
                <span class="row-sub">@BgName(st.Background)</span>
            </span>
            <Icon Name="chevron-down" Size="22" Stroke="2.4" />
        </button>
        @if (_open == "bg")
        {
            <div class="theme-panel">
                <div class="swatch-group-label">Dark</div>
                <div class="swatch-grid">
                    @foreach (var (name, val) in DarkBackgrounds)
                    {
                        <button class="swatch swatch--bg @(Same(st.Background, val) ? "active" : "")" style="background:@BgCss(val)"
                                title="@name" aria-label="@name" @onclick="() => SetBg(val)"></button>
                    }
                </div>
                <div class="swatch-group-label">Light</div>
                <div class="swatch-grid">
                    @foreach (var (name, val) in LightBackgrounds)
                    {
                        <button class="swatch swatch--bg @(Same(st.Background, val) ? "active" : "")" style="background:@BgCss(val)"
                                title="@name" aria-label="@name" @onclick="() => SetBg(val)"></button>
                    }
                </div>
                <label class="custom-color @(BgName(st.Background) == "Custom" ? "active" : "")">
                    <span class="swatch swatch--custom"><span class="swatch-wheel"></span></span>
                    <span>Custom color</span>
                    <input type="color" value="@FirstHex(st.Background)" @oninput="e => S.PreviewTheme(e.Value?.ToString() ?? st.Background, st.Accent)"
                           @onchange="e => SetBg(e.Value?.ToString())" />
                </label>
            </div>
        }

        <button class="theme-menu @(_open == "accent" ? "open" : "")" @onclick='() => ToggleMenu("accent")' aria-expanded="@(_open == "accent" ? "true" : "false")">
            <span class="theme-menu-swatch" style="background:@st.Accent"></span>
            <span class="row-main">
                <span class="row-title">Accent color</span>
                <span class="row-sub">@AccentName(st.Accent)</span>
            </span>
            <Icon Name="chevron-down" Size="22" Stroke="2.4" />
        </button>
        @if (_open == "accent")
        {
            <div class="theme-panel">
                <div class="swatch-grid">
                    @foreach (var (name, hex) in Accents)
                    {
                        <button class="swatch @(Same(st.Accent, hex) ? "active" : "")" style="background:@hex" title="@name"
                                aria-label="@name" @onclick="() => SetAccent(hex)"></button>
                    }
                </div>
                <label class="custom-color @(AccentName(st.Accent) == "Custom" ? "active" : "")">
                    <span class="swatch swatch--custom"><span class="swatch-wheel"></span></span>
                    <span>Custom color</span>
                    <input type="color" value="@st.Accent" @oninput="e => S.PreviewTheme(st.Background, e.Value?.ToString() ?? st.Accent)"
                           @onchange="e => SetAccent(e.Value?.ToString())" />
                </label>
            </div>
        }

        <div class="theme-preview">
            <span class="muted">Preview</span>
            <button class="btn-3d btn-small" tabindex="-1">START</button>
            <span class="check on"><Icon Name="check" Size="20" Stroke="3" /></span>
            @if (!Same(st.Background, Defaults.Background) || !Same(st.Accent, Defaults.Accent))
            {
                <button class="link-btn" @onclick="ResetTheme">Reset to default</button>
            }
        </div>
    </div>
</section>

<section class="settings-section">
    <div class="settings-title">Rest Timer</div>
    <div class="card settings-card">
        <div class="setting-row">
            <div class="row-main"><div class="row-title">Default rest</div><div class="row-sub">Exercises can override this from their ⋮ menu</div></div>
            <div class="stepper">
                <button class="stepper-btn" @onclick="() => AdjustRest(-15)" aria-label="Less rest"><Icon Name="minus" Size="18" Stroke="2.6" /></button>
                <span class="stepper-val">@ExerciseInfo.FormatRest(st.RestSeconds)</span>
                <button class="stepper-btn" @onclick="() => AdjustRest(15)" aria-label="More rest"><Icon Name="plus" Size="18" Stroke="2.6" /></button>
            </div>
        </div>
        <div class="setting-row">
            <div class="row-main"><div class="row-title">Start after checking a set</div></div>
            <Toggle Value="st.RestTimerEnabled" ValueChanged="v => { st.RestTimerEnabled = v; S.SaveSettings(); }" />
        </div>
        <div class="setting-row">
            <div class="row-main"><div class="row-title">Beep when rest is over</div><div class="row-sub">Only while LiftX is open. iOS mutes it when the silent switch is on.</div></div>
            <Toggle Value="st.TimerSound" ValueChanged="v => { st.TimerSound = v; S.SaveSettings(); }" />
        </div>
        <div class="setting-row">
            <div class="row-main"><div class="row-title">Keep screen awake during a lift</div><div class="row-sub">So the rest timer stays visible</div></div>
            <Toggle Value="st.KeepAwake" ValueChanged="v => { st.KeepAwake = v; S.SaveSettings(); }" />
        </div>
    </div>
</section>

<section class="settings-section">
    <div class="settings-title">Lift Screen</div>
    <div class="card settings-card">
        <div class="setting-row">
            <div class="row-main"><div class="row-title">Show what beats your PR</div><div class="row-sub">A small line above each exercise's sets, e.g. 185 × 6 or 190 × 5</div></div>
            <Toggle Value="st.ShowPrTargets" ValueChanged="v => { st.ShowPrTargets = v; S.SaveSettings(); }" />
        </div>
    </div>
</section>

<section class="settings-section">
    <div class="settings-title settings-title--row">
        <span>Save File</span>
        <button class="info-btn" @onclick="S.OpenSaveIntro"><Icon Name="info" Size="18" /> How saving works</button>
    </div>
    <div class="card settings-card">
        <div class="save-status @(S.Meta.Dirty ? "dirty" : "")">
            @if (S.Meta.Dirty)
            {
                <span class="dirty-badge dirty-badge--inline">!</span>
                <span>You have changes that aren't in your Files copy yet.</span>
            }
            else if (S.Meta.LastExportUtc is { } t)
            {
                <Icon Name="check" Size="18" Stroke="3" />
                <span>Saved to Files @t.ToLocalTime().ToString("MMM d, h:mm tt")</span>
            }
            else
            {
                <Icon Name="check" Size="18" Stroke="3" />
                <span>Up to date with the file you loaded</span>
            }
        </div>

        <button class="btn-3d btn-wide" @onclick="Save"><Icon Name="save" Stroke="2.6" /> Save to Files</button>
        <div class="row-sub help-text">
            Opens the share sheet. Pick <strong>Save to Files</strong>, choose the same folder as last time and tap <strong>Replace</strong>.
            The copy on this phone can be cleared by iOS every so often, so save after every lift.
        </div>

        <label class="field-label" for="file-name">File name</label>
        <input id="file-name" class="input" @bind="st.FileName" @bind:after="FileNameChanged" autocomplete="off" />

        <FileImport Class="btn-soft btn-wide" OnLoaded="OnImport" OnError="e => S.Toast(e)">
            <Icon Name="upload" Size="20" /> Load a different file
        </FileImport>
        <div class="row-sub help-text">LiftX file (.json) or Liftoff export (.csv). This replaces what's on this phone.</div>
    </div>
</section>

<section class="settings-section">
    <div class="settings-title">About</div>
    <div class="card settings-card about">
        <div><strong>LiftX</strong></div>
        <div class="muted">
            @S.Data.Workouts.Count workouts · @S.Library.Count() exercises · @S.Data.Routines.Count routines
        </div>
        <button class="btn-ghost btn-wide danger" @onclick="Erase"><Icon Name="trash" Size="18" /> Erase all data on this phone</button>
    </div>
</section>

<footer class="update-stamp">
    @if (string.IsNullOrEmpty(BuildInfo.Commit))
    {
        <div>Local build</div>
        <div>@BuildDate</div>
    }
    else
    {
        <div>Last update pushed</div>
        <div>@BuildDate · @BuildInfo.Commit</div>
    }
</footer>

@code {
    // Main colors are "top,bottom" gradients
    private static readonly (string Name, string Value)[] DarkBackgrounds =
    {
        ("Graphite", "#22252a,#0b0c0e"), ("Onyx", "#161616,#000000"), ("Midnight", "#18213a,#070a13"), ("Ocean", "#0f2b35,#040d11"),
        ("Forest", "#13291d,#040b07"), ("Plum", "#28173a,#0a0610"), ("Wine", "#35141b,#0e0406"), ("Ember", "#2f2116,#0c0805"),
    };

    private static readonly (string Name, string Value)[] LightBackgrounds =
    {
        ("Cloud", "#f6f7f9,#e4e6ea"), ("Pearl", "#f8f6f1,#e7e1d5"), ("Sky", "#f2f6fe,#d9e4f6"), ("Mint", "#f1faf5,#d8ede1"),
        ("Lavender", "#f6f2fe,#e3dbf4"), ("Blush", "#fdf3f4,#f2dcdf"), ("Sand", "#faf6ec,#ebdfc6"), ("Silver", "#eef0f3,#d4d8de"),
    };

    // No gold/yellow here on purpose: gold is saved for PRs
    private static readonly (string Name, string Hex)[] Accents =
    {
        ("Medium Sea Green", "#3CB371"), ("Lime", "#84CC16"), ("Teal", "#14B8A6"), ("Cyan", "#06B6D4"),
        ("Sky", "#38BDF8"), ("Blue", "#3B82F6"), ("Indigo", "#6366F1"), ("Purple", "#8B5CF6"),
        ("Fuchsia", "#D946EF"), ("Pink", "#EC4899"), ("Rose", "#F43F5E"), ("Red", "#E5463B"),
        ("Coral", "#FF7F50"), ("Orange", "#F27A1A"), ("Copper", "#C2703D"), ("Silver", "#CBD5E1"),
    };

    private string? _open; // which theme menu is expanded: "bg", "accent" or none
    private void ToggleMenu(string which) => _open = _open == which ? null : which;

    private static string BgCss(string v) => v.Contains(',') ? $"linear-gradient(160deg, {v.Replace(",", ", ")})" : v;
    private static string FirstHex(string v) => v.Split(',')[0];
    private static string BgName(string v) =>
        DarkBackgrounds.Concat(LightBackgrounds).FirstOrDefault(b => Same(b.Value, v)).Name ?? "Custom";
    private static string AccentName(string v) => Accents.FirstOrDefault(a => Same(a.Hex, v)).Name ?? "Custom";

    private static bool Same(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private string BuildDate
    {
        get
        {
            try { return DateTime.Parse(BuildInfo.BuildDateUtc, null, System.Globalization.DateTimeStyles.RoundtripKind).ToLocalTime().ToString("MMM d, yyyy 'at' h:mm:ss tt"); }
            catch { return "?"; }
        }
    }

    private void SetBg(string? hex)
    {
        if (string.IsNullOrEmpty(hex)) return;
        S.Data.Settings.Background = hex;
        S.SaveSettings();
    }

    private void SetAccent(string? hex)
    {
        if (string.IsNullOrEmpty(hex)) return;
        S.Data.Settings.Accent = hex;
        S.SaveSettings();
    }

    private void ResetTheme()
    {
        S.Data.Settings.Background = Defaults.Background;
        S.Data.Settings.Accent = Defaults.Accent;
        S.SaveSettings();
    }

    private void AdjustRest(int delta)
    {
        S.Data.Settings.RestSeconds = Math.Clamp(S.Data.Settings.RestSeconds + delta, 15, 600);
        S.SaveSettings();
    }

    private void FileNameChanged()
    {
        var n = (S.Data.Settings.FileName ?? "").Trim();
        if (n.Length == 0) n = Defaults.FileName;
        if (!n.EndsWith(".json", StringComparison.OrdinalIgnoreCase)) n += ".json";
        S.Data.Settings.FileName = n;
        S.SaveSettings();
    }

    private Task Save() => S.ExportAsync();

    private async Task OnImport((string Text, string Name) file)
    {
        if (!await D.Confirm($"Load {file.Name}?", "This replaces the lifts, routines and exercises on this phone with the ones in that file.",
                "Replace", danger: true))
            return;
        try { S.Toast(S.Import(file.Text, file.Name)); }
        catch (Exception ex) { await D.Confirm("Couldn't load that file", ex.Message, "OK", cancel: "Close"); }
    }

    private async Task Erase()
    {
        if (!await D.Confirm("Erase everything on this phone?",
                S.Meta.Dirty ? "⚠️ You have changes that aren't saved to Files. They'll be gone for good." : "Your file in Files is not touched.",
                "Erase", danger: true))
            return;
        S.EraseEverything();
    }
}
