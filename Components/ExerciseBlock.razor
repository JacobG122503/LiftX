@inject AppState S
@inject RestTimer Timer
@inject Dialogs D

@{
    var type = S.TypeOf(Exercise.Name);
    var cols = ExerciseInfo.Columns(type);
    var prev = S.PreviousSets(Exercise.Name, Live ? DateTime.MaxValue : Workout.Date, Workout.Id);
    var def = S.FindDef(Exercise.Name);
    var gridClass = Live ? "" : "no-check";
    var prSets = Live ? PrSets(type, Best()) : new HashSet<SetEntry>();
    _lastPr = prSets;
    var target = Live && S.Data.Settings.ShowPrTargets ? PrTarget(type) : null;
}

<div class="ex-card">
    <div class="ex-head">
        <div class="ex-title">
            <ExAvatar Name="@Exercise.Name" />
            <span class="ex-name">@Exercise.Name</span>
            <StatsButton Name="@Exercise.Name" OnClick="() => OnStats.InvokeAsync(Exercise.Name)" />
        </div>
        <button class="icon-btn accent" @onclick="() => _collapsed = !_collapsed" aria-label="Collapse">
            <Icon Name="@(_collapsed ? "chevron-down" : "chevron-up")" Stroke="2.6" />
        </button>
        <button class="icon-btn" @onclick="OnMenu" aria-label="Exercise options"><Icon Name="more" /></button>
    </div>

    @if (!_collapsed)
    {
        @if (!string.IsNullOrWhiteSpace(def?.Notes))
        {
            <button class="ex-note" @onclick="OnMenu"><Icon Name="note" Size="16" /> <span>@def!.Notes</span></button>
        }

        @if (target is { } tg)
        {
            <div class="pr-target" aria-label="To beat your PR">
                <span class="pr-target-label">Beat PR:</span>
                <span class="pr-target-chip">@tg.First</span>
                @if (tg.Second != null)
                {
                    <span class="pr-target-or">or</span>
                    <span class="pr-target-chip">@tg.Second</span>
                }
            </div>
        }

        <div class="set-grid set-head @gridClass">
            <div>SET</div>
            @if (cols.First != null)
            {
                <div>@cols.First</div>
                <div>@cols.Second</div>
            }
            else
            {
                <div class="span2">@cols.Second</div>
            }
            @if (Live)
            {
                <div></div>
            }
        </div>

        @for (int i = 0; i < Exercise.Sets.Count; i++)
        {
            var idx = i;
            var set = Exercise.Sets[i];
            var ph = Placeholder(idx, prev);
            var pr = prSets.Contains(set);
            var just = _justDone.Contains(set);
            var leaving = !set.Done && _leavingPr.Contains(set);
            <div class="set-grid set-row @gridClass @(set.Done ? "done" : "") @(pr ? "pr" : "") @(just ? "just-done" : "") @(leaving ? "pr-leaving" : "")" @key="set">
                <button class="set-num" @onclick="() => SetMenu(idx)">@(idx + 1)</button>

                @{ var fields = FieldsFor(type); }
                @foreach (var f in fields)
                {
                    var field = f;
                    var editing = Keypad.IsEditing(set, field);
                    var text = editing && !Keypad.Fresh ? Keypad.TypedText : (Shown(set, field) ?? Shown(ph, field) ?? "");
                    <button id="@CellId(set, field)"
                            class="set-input @(fields.Count == 1 ? "span2" : "") @(field == SetField.Time ? "set-input--time" : "") @(editing ? "editing" : "")"
                            @onclick="() => Edit(idx, set, field)" @onclick:stopPropagation="true">
                        @if (editing && Keypad.Fresh && text.Length > 0)
                        {
                            <span class="sel">@text</span>
                        }
                        else
                        {
                            @text
                        }
                        @if (editing && !Keypad.Fresh)
                        {
                            <span class="caret"></span>
                        }
                    </button>
                }

                @if (Live)
                {
                    <button class="check @(set.Done ? "on" : "")" @onclick="() => Toggle(idx, prev, type)" aria-label="Complete set">
                        <Icon Name="check" Size="22" Stroke="3" />
                        @if (just && pr)
                        {
                            <span class="pr-burst" aria-hidden="true">
                                @for (int k = 0; k < 10; k++)
                                {
                                    <i style="--a:@(k * 36)deg; --d:@(k % 2 == 0 ? 36 : 26)px"></i>
                                }
                            </span>
                        }
                    </button>
                }
            </div>
        }

        <button class="add-set" @onclick="AddSet"><Icon Name="plus" Size="18" Stroke="2.6" /> ADD SET</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public Workout Workout { get; set; } = default!;
    [Parameter, EditorRequired] public WorkoutExercise Exercise { get; set; } = default!;
    [Parameter] public bool Live { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnMenu { get; set; }
    /// <summary>Tapped the stats button. The lift shows the stats popup outside its scroll box (see WorkoutView).</summary>
    [Parameter] public EventCallback<string> OnStats { get; set; }
    [Parameter, EditorRequired] public KeypadState Keypad { get; set; } = default!;

    private static IReadOnlyList<SetField> FieldsFor(ExerciseType t) => t switch
    {
        ExerciseType.Weight or ExerciseType.Assisted => new[] { SetField.Weight, SetField.Reps },
        ExerciseType.Reps => new[] { SetField.Reps },
        ExerciseType.Duration => new[] { SetField.Time },
        _ => new[] { SetField.Distance, SetField.Time },
    };

    /// <summary>A set's value for one box, formatted (null = empty).</summary>
    private static string? Shown(SetEntry? s, SetField f) => s == null ? null : f switch
    {
        SetField.Weight => s.Weight is double w ? ExerciseInfo.Num(w) : null,
        SetField.Reps => s.Reps?.ToString(),
        SetField.Distance => s.Distance is double d ? ExerciseInfo.Num(d) : null,
        SetField.Time => s.Seconds is int t ? ExerciseInfo.FormatTime(t) : null,
        _ => null
    };

    private static string CellId(SetEntry s, SetField f) =>
        $"cell-{System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(s)}-{(int)f}";

    private Task Edit(int idx, SetEntry set, SetField field) =>
        Keypad.Open(set, field, FieldsFor(S.TypeOf(Exercise.Name)), Changed,
            Live ? () => CheckFromKeypad(idx) : null);

    /// <summary>DONE on the keypad's last box checks the set (if it isn't already).</summary>
    private async Task CheckFromKeypad(int idx)
    {
        if (idx >= Exercise.Sets.Count || Exercise.Sets[idx].Done) return;
        var prev = S.PreviousSets(Exercise.Name, DateTime.MaxValue, Workout.Id);
        await Toggle(idx, prev, S.TypeOf(Exercise.Name));
        StateHasChanged();
    }

    private bool _collapsed;

    // Sets checked in the last moment: they get the fill / PR animation (not replayed on re-render or resume)
    private readonly HashSet<SetEntry> _justDone = new();
    // Gold sets that were just unchecked: the fill leaves in gold instead of flashing the accent colour
    private readonly HashSet<SetEntry> _leavingPr = new();
    // Latest animation token per set. A timer only ends the animation it started, so checking,
    // unchecking and re-checking quickly never cuts the newest animation short.
    private readonly Dictionary<SetEntry, int> _animToken = new();
    private int _animSeq;
    private HashSet<SetEntry> _lastPr = new();

    // Your best for this exercise before this lift (cached until the data changes, or the exercise is
    // replaced — Replace keeps this same card and only changes its name). Null the first time you do it.
    private PrBar? _best;
    private int _bestVersion = -1;
    private string? _bestName;

    private PrBar? Best()
    {
        if (_bestVersion == S.Version && _bestName == Exercise.Name) return _best;
        _bestVersion = S.Version;
        _bestName = Exercise.Name;
        _best = PrBar.From(S.HistoryOf(Exercise.Name).Where(h => h.W.Id != Workout.Id).SelectMany(h => h.E.Sets));
        return _best;
    }

    /// <summary>
    /// Which checked sets are PRs (the shared rule in <see cref="PrBar"/>, also used for gold days on the calendar).
    /// Goes through them in the order you checked them: a set is gold only if it beats your all-time best
    /// AND every set of this exercise you checked before it in this lift.
    /// </summary>
    private HashSet<SetEntry> PrSets(ExerciseType type, PrBar? best)
    {
        var result = new HashSet<SetEntry>();
        _run = null;
        if (best == null) return result;
        var bar = new PrBar(best.Est1RM, best.Weight, best.WeightReps, best.Reps, best.Seconds);
        var checkedSets = Workout.Exercises
            .Where(e => AppState.SameName(e.Name, Exercise.Name))
            .SelectMany(e => e.Sets)
            .Where(s => s.Done);
        foreach (var s in PrBar.InDoneOrder(checkedSets))
            if (bar.Beat(s, type)) result.Add(s);
        _run = bar;
        return result;
    }

    // The best to beat right now: all-time best, raised by anything better checked in this lift
    private PrBar? _run;

    /// <summary>
    /// What beats your PR: for weight lifts, more reps at your PR weight, or the reps needed at the next
    /// 5 lb step up (by estimated 1-rep max, the same rule that turns a set gold).
    /// Nothing the first time you ever do an exercise.
    /// </summary>
    private (string First, string? Second)? PrTarget(ExerciseType type)
    {
        if (_run is not { } r) return null;
        switch (type)
        {
            case ExerciseType.Weight when r.Est1RM > 0 && r.Weight > 0:
                var next = Math.Floor(r.Weight / 5) * 5 + 5;
                return ($"{ExerciseInfo.Num(r.Weight)} × {RepsToBeat(r.Est1RM, r.Weight)}",
                        $"{ExerciseInfo.Num(next)} × {RepsToBeat(r.Est1RM, next)}");
            case ExerciseType.Reps when r.Reps > 0:
                return ($"{r.Reps + 1} reps", null);
            case ExerciseType.Duration when r.Seconds > 0:
                return (ExerciseInfo.FormatTime(r.Seconds + 1), null);
            default:
                return null;
        }
    }

    /// <summary>Fewest reps at this weight whose estimated 1-rep max beats the best (matches the gold rule).</summary>
    private static int RepsToBeat(double est, double weight) =>
        Math.Max(1, (int)Math.Floor(30 * ((est + 0.05) / weight - 1)) + 1);

    private int NewAnimToken(SetEntry set) => _animToken[set] = ++_animSeq;
    private bool IsLatest(SetEntry set, int token) => _animToken.TryGetValue(set, out var t) && t == token;

    private async Task PlayCheckAnimation(SetEntry set)
    {
        var token = NewAnimToken(set);
        _leavingPr.Remove(set);
        _justDone.Add(set);
        await Task.Delay(2200);
        if (!IsLatest(set, token)) return; // checked again since: that newer animation ends itself
        _justDone.Remove(set);
        _animToken.Remove(set);
        StateHasChanged();
    }

    private async Task PlayUncheck(SetEntry set, bool wasPr)
    {
        var token = NewAnimToken(set);
        _justDone.Remove(set);
        if (!wasPr) { _animToken.Remove(set); return; }
        _leavingPr.Add(set);
        await Task.Delay(350);
        if (!IsLatest(set, token)) return;
        _leavingPr.Remove(set);
        _animToken.Remove(set);
        StateHasChanged();
    }

    private Task Changed() => OnChanged.InvokeAsync();

    /// <summary>
    /// What to show greyed out in an empty input: what you did on this set last time
    /// (or your last set, if you're doing more sets than last time), else the set above.
    /// </summary>
    private SetEntry? Placeholder(int idx, List<SetEntry>? prev)
    {
        if (prev is { Count: > 0 }) return prev[Math.Min(idx, prev.Count - 1)];
        for (int i = idx - 1; i >= 0; i--)
            if (Exercise.Sets[i].HasValues) return Exercise.Sets[i];
        return null;
    }

    private async Task Toggle(int idx, List<SetEntry>? prev, ExerciseType type)
    {
        if (Keypad.IsOpen) await Keypad.CloseAsync();
        var set = Exercise.Sets[idx];
        if (set.Done)
        {
            set.Done = false;
            set.DoneOrder = null;
            _ = PlayUncheck(set, _lastPr.Contains(set));
            // Numbers that just came from the grey values go back to grey
            var grey = Placeholder(idx, prev);
            if (grey?.Weight != null ? set.Weight == grey.Weight : set.Weight == 0) set.Weight = null;
            if (grey?.Reps != null && set.Reps == grey.Reps) set.Reps = null;
            if (grey?.Distance != null && set.Distance == grey.Distance) set.Distance = null;
            if (grey?.Seconds != null && set.Seconds == grey.Seconds) set.Seconds = null;
            await Changed();
            return;
        }

        // Empty boxes take the greyed-out values, so you can just tap ✓ to repeat last time
        var ph = Placeholder(idx, prev);
        if (ph != null)
        {
            switch (type)
            {
                case ExerciseType.Weight:
                case ExerciseType.Assisted:
                    set.Weight ??= ph.Weight;
                    set.Reps ??= ph.Reps;
                    break;
                case ExerciseType.Reps:
                    set.Reps ??= ph.Reps;
                    break;
                case ExerciseType.Duration:
                    set.Seconds ??= ph.Seconds;
                    break;
                default:
                    set.Distance ??= ph.Distance;
                    set.Seconds ??= ph.Seconds;
                    break;
            }
        }
        if (ExerciseInfo.UsesWeight(type)) set.Weight ??= 0;

        bool valid = type switch
        {
            ExerciseType.Weight or ExerciseType.Assisted or ExerciseType.Reps => set.Reps is > 0,
            ExerciseType.Duration => set.Seconds is > 0,
            _ => set.Seconds is > 0 || set.Distance is > 0
        };
        if (!valid)
        {
            S.Toast(ExerciseInfo.UsesTime(type) ? "Enter a time first" : "Enter your reps first");
            return;
        }

        set.Done = true;
        set.DoneOrder = Workout.Exercises.SelectMany(e => e.Sets).Max(s => s.DoneOrder ?? 0) + 1;
        _ = PlayCheckAnimation(set);
        S.UnlockAudio(); // lets the end-of-rest beep play later (iOS needs a tap first)
        if (S.Data.Settings.RestTimerEnabled)
            Timer.Start(S.RestFor(Exercise.Name));
        await Changed();
    }

    private async Task AddSet()
    {
        Exercise.Sets.Add(new SetEntry());
        await Changed();
    }

    private async Task SetMenu(int idx)
    {
        var choice = await D.Choose($"Set {idx + 1}", new ActionItem("Insert set above"), new ActionItem("Delete set", Danger: true));
        if (choice == 0) Exercise.Sets.Insert(idx, new SetEntry());
        else if (choice == 1 && idx < Exercise.Sets.Count) Exercise.Sets.RemoveAt(idx);
        else return;
        await Changed();
        StateHasChanged();
    }
}
