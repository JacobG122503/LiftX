@inherits StateComponent
@inject Dialogs D

<div class="shell">
    <header class="topbar">
        <button class="text-btn" @onclick="Cancel">Cancel</button>
        <h1 class="topbar-title topbar-title--center">@(S.EditingRoutineIsNew ? "New Routine" : "Edit Routine")</h1>
        <button class="text-btn accent" @onclick="Save">Save</button>
    </header>

    <main class="content content--no-nav">
        <input class="input input-big" placeholder="Routine name (e.g. Push Day)" @bind="Routine.Name" />
        <div class="muted re-summary">@Routine.Exercises.Count exercises · @Routine.Exercises.Sum(e => e.Sets) sets</div>

        @for (int i = 0; i < Routine.Exercises.Count; i++)
        {
            var idx = i;
            var ex = Routine.Exercises[i];
            <div class="card re-row" @key="ex">
                <ExAvatar Name="@ex.Name" />
                <div class="re-main">
                    <div class="row-title re-name">@ex.Name <StatsButton Name="@ex.Name" Size="16" OnClick="() => _statsFor = ex.Name" /></div>
                    <div class="stepper">
                        <button class="stepper-btn" @onclick="() => ex.Sets = Math.Max(1, ex.Sets - 1)" aria-label="Fewer sets"><Icon Name="minus" Size="18" Stroke="2.6" /></button>
                        <span class="stepper-val">@ex.Sets @(ex.Sets == 1 ? "set" : "sets")</span>
                        <button class="stepper-btn" @onclick="() => ex.Sets = Math.Min(20, ex.Sets + 1)" aria-label="More sets"><Icon Name="plus" Size="18" Stroke="2.6" /></button>
                    </div>
                </div>
                <div class="re-actions">
                    <button class="icon-btn" disabled="@(idx == 0)" @onclick="() => Move(idx, -1)" aria-label="Move up"><Icon Name="arrow-up" Size="20" /></button>
                    <button class="icon-btn" disabled="@(idx == Routine.Exercises.Count - 1)" @onclick="() => Move(idx, 1)" aria-label="Move down"><Icon Name="arrow-down" Size="20" /></button>
                    <button class="icon-btn danger" @onclick="() => Routine.Exercises.RemoveAt(idx)" aria-label="Remove"><Icon Name="x" Size="20" /></button>
                </div>
            </div>
        }

        <div class="center-row">
            <button class="btn-3d btn-big" @onclick="() => _picker = true"><Icon Name="plus" Stroke="3" /> Exercise</button>
        </div>
    </main>
</div>

@if (_picker)
{
    <ExercisePicker Title="Add to Routine" OnPicked="OnPicked" OnClose="() => _picker = false" />
}

@if (_statsFor != null)
{
    <ExerciseStatsModal Name="@_statsFor" OnClose="() => _statsFor = null" />
}

@code {
    private string? _statsFor;
    [Parameter, EditorRequired] public Routine Routine { get; set; } = default!;
    private bool _picker;

    private void Move(int idx, int delta)
    {
        var j = idx + delta;
        if (j < 0 || j >= Routine.Exercises.Count) return;
        (Routine.Exercises[idx], Routine.Exercises[j]) = (Routine.Exercises[j], Routine.Exercises[idx]);
    }

    private void OnPicked(List<string> names)
    {
        foreach (var n in names)
        {
            var type = S.TypeOf(n);
            Routine.Exercises.Add(new RoutineExercise { Name = n, Sets = ExerciseInfo.UsesTime(type) ? 1 : 3 });
        }
        _picker = false;
    }

    private async Task Cancel()
    {
        if (await D.Confirm("Discard changes?", null, "Discard", danger: true, cancel: "Keep editing"))
            S.CancelEditRoutine();
    }

    private void Save()
    {
        if (Routine.Exercises.Count == 0)
        {
            S.Toast("Add at least one exercise");
            return;
        }
        S.SaveRoutine();
        S.Toast("Routine saved");
    }
}
