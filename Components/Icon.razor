<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "chevron-down": <polyline points="6 9 12 15 18 9" /> break;
        case "chevron-up": <polyline points="18 15 12 9 6 15" /> break;
        case "chevron-left": <polyline points="15 18 9 12 15 6" /> break;
        case "chevron-right": <polyline points="9 18 15 12 9 6" /> break;
        case "arrow-right": <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /> break;
        case "arrow-up": <line x1="12" y1="19" x2="12" y2="5" /><polyline points="5 12 12 5 19 12" /> break;
        case "arrow-down": <line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" /> break;
        case "more":
            <circle cx="12" cy="5" r="1.7" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none" />
            <circle cx="12" cy="19" r="1.7" fill="currentColor" stroke="none" />
            break;
        case "timer": <circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2.5" /><path d="M9.5 2.5h5" /> break;
        case "plus": <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /> break;
        case "minus": <line x1="5" y1="12" x2="19" y2="12" /> break;
        case "check": <polyline points="20 6 9 17 4 12" /> break;
        case "x": <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /> break;
        case "trash":
            <polyline points="3 6 5 6 21 6" />
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
            <path d="M10 11v6M14 11v6" />
            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
            break;
        case "edit": <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /> break;
        case "save":
            <path d="M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" />
            <polyline points="8 10 12 14 16 10" />
            <line x1="12" y1="3" x2="12" y2="14" />
            break;
        case "upload":
            <path d="M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" />
            <polyline points="16 7 12 3 8 7" />
            <line x1="12" y1="3" x2="12" y2="15" />
            break;
        case "gear":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            break;
        case "list":
            <rect x="8" y="2" width="8" height="4" rx="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <path d="M9 12h6M9 16h6" />
            break;
        case "dumbbell":
            <rect x="5" y="6" width="3.5" height="12" rx="1" />
            <rect x="15.5" y="6" width="3.5" height="12" rx="1" />
            <path d="M2.5 9.5v5M21.5 9.5v5M8.5 12h7" />
            break;
        case "calendar":
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
            break;
        case "chart": <path d="M3 3v18h18" /><path d="M7 15l4-4 3 3 5-6" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /> break;
        case "note":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <path d="M8 13h8M8 17h5" />
            break;
        case "trophy":
            <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z" />
            <path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3" />
            break;
        case "share":
            <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
            break;
        case "play": <polygon points="7 4 20 12 7 20 7 4" fill="currentColor" /> break;
        case "info": <circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /> break;
        case "copy": <rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /> break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public double Stroke { get; set; } = 2;
    [Parameter] public string? Class { get; set; }
}
